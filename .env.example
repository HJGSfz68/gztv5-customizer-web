# Public no-login mode is intentionally the default; anyone can submit builds and download APKs.
# Replace CHANGE_ME with a random 64-character secret; keep .env mode 600 and out of version control.
PUBLIC_MODE=1
BIND_ADDRESS=0.0.0.0
HOST_PORT=1212
APP_SECRET_KEY=CHANGE_ME
COOKIE_SECURE=0

# Resource limits for small hosts; builds may be slower or hit the Java heap cap.
BUILD_CPU_LIMIT=0.75
BUILD_MEMORY_LIMIT=448m
JAVA_MAX_HEAP=288m
