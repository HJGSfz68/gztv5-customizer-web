[Unit]
Description=GZTV5 APK Customizer (resource-limited)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=webapp
Group=webapp
WorkingDirectory=/opt/GZTV5_customizer_web
EnvironmentFile=/etc/gztv5-customizer.env
ExecStart=/opt/GZTV5_customizer_web/.venv/bin/uvicorn webapp:app --host 0.0.0.0 --port 1212 --workers 1
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
KillSignal=SIGTERM

Nice=10
CPUQuota=75%
MemoryMax=448M
MemorySwapMax=0
OOMScoreAdjust=500
TasksMax=128
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/GZTV5_customizer_web/runtime
ReadOnlyPaths=/opt/GZTV5_customizer_web/private
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
