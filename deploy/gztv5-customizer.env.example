# Copy to /etc/gztv5-customizer.env and chmod 600.
# Public no-login mode is intentional; replace CHANGE_ME before starting.
PUBLIC_MODE=1
COOKIE_SECURE=0
APP_SECRET_KEY=CHANGE_ME
GZTV5_BASE_APK=/opt/GZTV5_customizer_web/private/base.apk
GZTV5_KEYSTORE=/opt/GZTV5_customizer_web/private/signing.p12
GZTV5_PASSFILE=/opt/GZTV5_customizer_web/private/signing.pass
GZTV5_RUNTIME_DIR=/opt/GZTV5_customizer_web/runtime
TMPDIR=/opt/GZTV5_customizer_web/runtime/tmp
HOME=/opt/GZTV5_customizer_web/runtime/home
PYTHONDONTWRITEBYTECODE=1
JAVA_TOOL_OPTIONS="-XX:ActiveProcessorCount=1 -Xms32m -Xmx288m -XX:+UseSerialGC -Djava.io.tmpdir=/opt/GZTV5_customizer_web/runtime/tmp"
